{
  "authoritative_gate": "scripts/final-gate.sh",
  "authoritative_workflow": ".github/workflows/release-gates.yml",
  "closed_world_source_required": true,
  "freeze_iteration": "15.18",
  "mutation_rule": "new_iteration_and_refreeze_required",
  "release_version_input": "release_version",
  "required_event": "workflow_dispatch",
  "required_ref": "refs/heads/main",
  "required_source_bound_paths": [
    "composer.json",
    "composer.lock",
    "package.json",
    "package-lock.json",
    "requirements-e2e.txt",
    "config/release-environment.json",
    "config/release-closure-verification-matrix.json",
    "config/release-archive-policy.json",
    "config/source-freeze-policy.json",
    ".github/workflows/release-gates.yml",
    "scripts/final-gate.sh",
    "scripts/ci_evidence.py",
    "scripts/consume_external_ci.py",
    "scripts/release_decision.py",
    "scripts/production_deployment_intake.py",
    "scripts/post_deploy_verify.sh",
    "scripts/production_operational_acceptance.py",
    "scripts/release_closure_handoff.py",
    "scripts/release_closure_matrix.py",
    "scripts/release_archive.py",
    "scripts/source_freeze.py",
    "config/external-runtime-target-policy.json",
    "scripts/external_runtime_target.py",
    "scripts/github_repository_onboarding.py",
    "docs/GITHUB_REPOSITORY_ONBOARDING.md",
    "config/repository-materialization-policy.json",
    "scripts/repository_materialization.py",
    "docs/GITHUB_REPOSITORY_MATERIALIZATION.md"
  ],
  "schema": "nadi.source-freeze-policy.v1",
  "version": 1
}
