APP_NAME=NADI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nadi.example.co.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nadi_lsp_migas
DB_USERNAME=nadi_app
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=nadi-session

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.co.id
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

NADI_LOGIN_MAX_ATTEMPTS=5
NADI_LOGIN_IP_MAX_ATTEMPTS=30
NADI_LOGIN_DECAY_SECONDS=60
VITE_DEMO_MODE=false
NADI_ALLOW_DEMO_SEED=false

# NADI monitoring
NADI_CRITICAL_ESCALATE_LEVEL1_MINUTES=120
NADI_CRITICAL_ESCALATE_LEVEL2_MINUTES=480
NADI_NOTIFICATION_RETENTION_DAYS=180
NADI_SSE_STREAM_SECONDS=20

# Reverse proxy IP/CIDR list. Leave empty for direct connections.
NADI_TRUSTED_PROXIES=
